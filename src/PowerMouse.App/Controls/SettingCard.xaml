<UserControl
    x:Class="PowerMouse.App.Controls.SettingCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Border
        Margin="0,0,0,2"
        Padding="16,14"
        Background="{ThemeResource PowerMouseCardBackgroundBrush}"
        BorderBrush="{ThemeResource PowerMouseCardBorderBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                Width="32"
                Height="32"
                VerticalAlignment="Center"
                Background="{ThemeResource PowerMouseSubtleFillBrush}"
                CornerRadius="6">
                <FontIcon
                    FontFamily="{x:Bind IconFontFamily, Mode=OneWay}"
                    FontSize="16"
                    Glyph="{x:Bind IconGlyph, Mode=OneWay}" />
            </Border>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="3">
                <TextBlock
                    FontWeight="SemiBold"
                    Text="{x:Bind Header, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Style="{StaticResource PowerMouseCaptionStyle}"
                    Text="{x:Bind Description, Mode=OneWay}" />
            </StackPanel>

            <ContentPresenter
                Grid.Column="2"
                MinWidth="160"
                Margin="18,0,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Content="{x:Bind ActionContent, Mode=OneWay}" />
        </Grid>
    </Border>
</UserControl>
